{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/about-colpitts-electric", "permanent": true },
    { "source": "/commercial", "destination": "/commercial-electrical-services-denver", "permanent": true },
    { "source": "/residential", "destination": "/residential-electrician-denver", "permanent": true },
    { "source": "/manpower", "destination": "/commercial-electrical-manpower-denver", "permanent": true },
    { "source": "/services", "destination": "/commercial-electrical-services-denver", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
